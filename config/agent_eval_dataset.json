                "3",
                "5"
            ]
        }
    },
    {
        "id": "policy_password",
        "inputs": {
            "message": "How long is the password reset link valid?"
        },
        "outputs": {
            "expected_intent": "policy",
            "expected_tools": [
                "rag_policy_lookup"
            ],
            "expected_task_completed": true,
            "answer_must_contain": [
                "15"
            ]
        }
    },
    {
        "id": "order_lookup",
        "inputs": {
            "message": "Where is ORD-1001?"
        },
        "outputs": {
            "expected_intent": "order",
            "expected_tools": [
                "order_lookup"
            ],
            "expected_task_completed": true,
            "answer_must_contain": [
                "ORD-1001",
                "SHIPPED"
            ]
        }
    },
    {
        "id": "unknown_order",
        "inputs": {
            "message": "Where is ORD-9999?"
        },
        "outputs": {
            "expected_intent": "order",
            "expected_tools": [
                "order_lookup"
            ],
            "expected_task_completed": false,
            "answer_must_contain": [
                "ORD-9999",
                "not found"
            ]
        }
    },
    {
        "id": "order_policy",
        "inputs": {
            "message": "Can I return ORD-1001?"
        },
        "outputs": {
            "expected_intent": "order_policy",
            "expected_tools": [
                "order_lookup",
                "rag_policy_lookup"
            ],
            "expected_task_completed": true,
            "answer_must_contain": [
                "ORD-1001",
                "30"
            ]
        }
    },
    {
